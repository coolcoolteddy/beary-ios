{"sourceLanguage":"zh-Hans","strings":{"app_lock.biometrics":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Biometrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"生物识别"}}}},"app_lock.biometry_not_available":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"This device doesn't support biometrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备不支持生物识别"}}}},"app_lock.biometry_not_enrolled":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ isn't set up on this device. Set it up in Settings first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备未录入%@，请先在系统设置中录入"}}}},"app_lock.biometry_unavailable":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Biometrics is temporarily unavailable on this device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备暂无法使用生物识别"}}}},"app_lock.cold_start_note":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify once on a cold start. Switching to another app and back won't ask again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷启动时验证一次；切到别的 App 再回来不重复。"}}}},"app_lock.face_id":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Face ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"面容识别"}}}},"app_lock.locked":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"beary is locked"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"beary 已锁定"}}}},"app_lock.passcode_not_set":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"No device passcode is set. Set one in Settings first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备未设置密码，请先在系统设置中设置密码"}}}},"app_lock.touch_id":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Touch ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"触控 ID"}}}},"app_lock.unlock":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlock"}},"zh-Ha