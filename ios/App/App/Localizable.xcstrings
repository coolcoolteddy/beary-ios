{"sourceLanguage":"zh-Hans","strings":{"account.delete_confirm_message":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Signing in within the 7-day cooling-off period cancels the deletion. After 7 days, your account will be permanently deleted and all your diaries deleted by default. You can choose to keep your public diaries, and their author will show as “Deleted user”.\n\nAfter deletion, your Plus, pending invite rewards, and favorites will be voided."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"7 天冷静期内登录可取消注销。7 天后账户正式注销，默认删除全部日记；注销时可勾选保留公开篇，保留的公开篇作者显示为“已注销用户”。\n\n注销后，你的 Plus、未到账的邀请奖励和收藏会一并作废。"}}}},"account.delete_confirm_title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete Account"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"注销账户"}}}},"account.delete_keep_public_subtitle":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"So people who have read them can revisit them. The author will show as “Deleted user”."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"供曾读过的人回看，作者显示为“已注销用户”"}}}},"account.delete_keep_public_title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep my public diaries"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保留我公开过的日记"}}}},"account.deleted_user_display_name":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deleted user"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已注销用户"}}}},"app_lock.biometrics":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Biometrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"生物识别"}}}},"app_lock.biometry_not_available":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"This device doesn't support biometrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备不支持生物识别"}}}},"app_lock.biometry_not_enrolled":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ isn't set up on this device. Set it up in Settings first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备未录入%@，请先在系统设置中录入"}}}},"app_lock.biometry_unavailable":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Biometrics is temporarily unavailable on this device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备暂无法使用生物识别"}}}},"app_lock.cold_start_note":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify once on a cold start. Switching to another app and back won't ask again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷启动时验证一次；切到别的 App 再回来不重复。"}}}},"app_lock.face_id":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Face ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"面容识别"}}}},"app_lock.locked":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"beary is locked"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"beary 已锁定"}}}},"app_lock.passcode_not_set":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"No device passcode is set. Set one in Settings first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备未设置密码，请先在系统设置中设置密码"}}}},"app_lock.touch_id":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Touch ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"触控 ID"}}}},"app_lock.unlock":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlock"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"解锁"}}}},"app_lock.unlock_beary_with_biometry":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use %@ to unlock beary"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用%@解锁 beary"}}}},"app_lock.unlock_with_biometry":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlock with %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用%@解锁"}}}},"app_lock.verification_failed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verification failed. Try again, or use your device passcode to unlock."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"验证未通过，请再试一次，也可用设备密码解锁"}}}}},"version":"1.0"}
