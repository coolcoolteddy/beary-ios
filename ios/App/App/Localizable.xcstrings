{"sourceLanguage":"zh-Hans","strings":{"beary 已锁定":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"beary is locked"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"beary 已锁定"}}}},"使用%@解锁":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlock with %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用%@解锁"}}}},"使用%@解锁 beary":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use %@ to unlock beary"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用%@解锁 beary"}}}},"冷启动时验证一次；切到别的 App 再回来不重复。":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify once on a cold start. Switching to another app and back won't ask again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷启动时验证一次；切到别的 App 再回来不重复。"}}}},"此设备不支持生物识别":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"This device doesn't support biometrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备不支持生物识别"}}}},"此设备暂无法使用生物识别":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Biometrics is temporarily unavailable on this device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备暂无法使用生物识别"}}}},"生物识别":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Biometrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"生物识别"}}}},"解锁":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlock"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"解锁"}}}},"触控 ID":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Touch ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"触控 ID"}}}},"设备未录入%@，请先在系统设置中录入":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ isn't set up on this device. Set it up in Settings first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备未录入%@，请先在系统设置中录入"}}}},"设备未设置密码，请先在系统设置中设置密码":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"No device passcode is set. Set one in Settings first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备未设置密码，请先在系统设置中设置密码"}}}},"面容识别":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Face ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"面容识别"}}}},"验证未通过，请再试一次，也可用设备密码解锁":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verification failed. Try again, or use your device passcode to unlock."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"验证未通过，请再试一次，也可用设备密码解锁"}}}}},"version":"1.0"}